	<oval-def:definitions>
		<definition id="oval:navy.navwar.niwcatlantic.scc.ios:def:1" version="2" class="compliance">
          <metadata>
            <title>Evaluate to true if the Cisco IOS line test is properly supported</title>
            <description></description>
          </metadata>
          <criteria>
            <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.ios:tst:1" comment="Test gathering show running-config with a pattern match"/>
			<criterion test_ref="oval:navy.navwar.niwcatlantic.scc.ios:tst:2" comment="Test gathering show interfaces with a pattern match"/>
          </criteria>
        </definition>
	</oval-def:definitions>
	<oval-def:tests>
		<line_test id="oval:navy.navwar.niwcatlantic.scc.ios:tst:1" version="1" 
		comment="Test gathering show running-config with a pattern match" check_existence="at_least_one_exists" check="all" 
		xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#ios" >
          <object object_ref="oval:navy.navwar.niwcatlantic.scc.ios:obj:1" />
          <state state_ref="oval:navy.navwar.niwcatlantic.scc.ios:ste:1" />
        </line_test>
		
		
		<line_test id="oval:navy.navwar.niwcatlantic.scc.ios:tst:2" version="1" 
		comment="Test gathering show interfaces with a string pattern match" check_existence="at_least_one_exists" check="all" 
		xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#ios" >
          <object object_ref="oval:navy.navwar.niwcatlantic.scc.ios:obj:2" />
          <state state_ref="oval:navy.navwar.niwcatlantic.scc.ios:ste:2" />
        </line_test>
	</oval-def:tests>
	<oval-def:objects>
		<line_object id="oval:navy.navwar.niwcatlantic.scc.ios:obj:1" version="1" 
		comment="show running-config" 
		xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#ios" >
          <show_subcommand datatype="string">show running-config</show_subcommand>
        </line_object>
		
		<line_object id="oval:navy.navwar.niwcatlantic.scc.ios:obj:2" version="1" 
