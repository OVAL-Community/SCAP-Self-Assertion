      <metadata>
        <title>Evaluate to true if the Cisco IOS-XE version test is properly supported</title>
        <description></description>
      </metadata>
      <criteria>
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:1" comment="Test iosxe version test 'version_string' with a pattern match"/>
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:2" comment="Test iosxe version test 'major_release' with operation greater than"/>
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:3" comment="Test iosxe version test 'release' with operation greater than or equal"/>
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:4" comment="Test iosxe version test 'rebuild' with operation greater than or equal"/>
        <criterion test_ref="oval:navy.navwar.niwcatlantic.scc.iosxe:tst:5" comment="Test iosxe version test 'train' with a pattern match"/>
