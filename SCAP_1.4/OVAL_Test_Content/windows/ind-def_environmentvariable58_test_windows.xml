  <definitions>
    <definition id="oval:org.mitre.oval.test:def:360" version="1" class="miscellaneous">
      <metadata>
        <title>Evaluate to true if the ind-def:environmentvariable58_test is properly supported</title>
        <description>This definition is intended to evalutate to true if the interpreter properly supports the ind-def:environmentvariable58_test and all of its valid operations.</description>
      </metadata>
      <notes>
        <note>It is important to note that the values used in this test definition are specific to a particular machine, and may not necessarily apply to your system. As a result, in order to have the definition return a result of 'true', you must either change these values to the ones found on your particular system, or you must configure your system to use these values.</note>
      </notes>
      <criteria operator="AND">
        <criterion comment="Test that the current process can be queried using a nil pid" test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:1"/>
		<criterion comment="Test that the current process can be queried using a nil pid, with case insensitive equals" test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:2"/>
		<criterion comment="Test querying a process (current process via var_ref), with case insensitive not equals use on name" test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:3"/>
        <criterion comment="Test querying a process (current process via var_ref), with not equals use on name" test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:4"/>
        <criterion comment="A slightly more complex query which scans all processes and uses a regex on the variable name" test_ref="oval:navy.navwar.niwcatlantic.scc.test:tst:5"/>
      </criteria>
    </definition>
  </definitions>
  <tests>
    <environmentvariable58_test id="oval:navy.navwar.niwcatlantic.scc.test:tst:1" version="1" comment="Test that the current process can be queried using a nil pid" check_existence="at_least_one_exists" check="at least one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.test:obj:1"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.test:ste:1"/>
    </environmentvariable58_test>
	<environmentvariable58_test id="oval:navy.navwar.niwcatlantic.scc.test:tst:2" version="1" comment="Test that the current process can be queried using a nil pid, with case insensitive equals" check_existence="at_least_one_exists" check="at least one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.test:obj:2"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.test:ste:1"/>
    </environmentvariable58_test>
    <environmentvariable58_test id="oval:navy.navwar.niwcatlantic.scc.test:tst:3" version="1" comment="Test querying a process (current process via var_ref), with case insensitive not equals" check_existence="at_least_one_exists" check="at least one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.test:obj:3"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.test:ste:3"/>
    </environmentvariable58_test>
	<environmentvariable58_test id="oval:navy.navwar.niwcatlantic.scc.test:tst:4" version="1" comment="Test querying a process (current process via var_ref), with case insensitive not equals" check_existence="at_least_one_exists" check="at least one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.test:obj:4"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.test:ste:3"/>
    </environmentvariable58_test>
    <environmentvariable58_test id="oval:navy.navwar.niwcatlantic.scc.test:tst:5" version="1" comment="A slightly more complex query which scans all processes and uses a regex on the variable name" check_existence="at_least_one_exists" check="at least one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <object object_ref="oval:navy.navwar.niwcatlantic.scc.test:obj:5"/>
      <state state_ref="oval:navy.navwar.niwcatlantic.scc.test:ste:5"/>
    </environmentvariable58_test>
  </tests>
  <objects>
    <environmentvariable58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:1" version="1" comment="Get the Windows directory" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <pid datatype="int" xsi:nil="true"/>
      <name>WINDIR</name>
    </environmentvariable58_object>
	<environmentvariable58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:2" version="1" comment="Get the Windows directory using case insensitive equals" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <pid datatype="int" xsi:nil="true"/>
      <name operation="case insensitive equals">windir</name>
    </environmentvariable58_object>
    <environmentvariable58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:3" version="1" comment="Get windows directory of a particular pid (curent process via var_ref.)" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <oval-def:notes>
        <oval-def:note>There's no fixed pid to use here (cannot use 4: system)...Let's use the current process again (via var_ref.)</oval-def:note>
      </oval-def:notes>
      <pid  datatype="int" var_ref="oval:navy.navwar.niwcatlantic.scc.test:var:3" />
      <name operation="case insensitive not equal">windir</name>
    </environmentvariable58_object>
	<environmentvariable58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:4" version="1" comment="Get WINDIR env vars of a particular pid (curent process via var_ref.)" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <oval-def:notes>
        <oval-def:note>There's no fixed pid to use here (cannot use 4: system)...Let's use the current process again (via var_ref.)</oval-def:note>
      </oval-def:notes>
      <pid  datatype="int" var_ref="oval:navy.navwar.niwcatlantic.scc.test:var:3" />
      <name operation="not equal">WINDIR</name>
    </environmentvariable58_object>
    <environmentvariable58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:5" version="1" comment="Get env vars of all processes which start with S" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <pid datatype="int" operation="greater than">4</pid>
      <name operation="pattern match">^S</name>
    </environmentvariable58_object>
  </objects>
  <states>
    <environmentvariable58_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:1" version="1" comment="name must be WINDIR" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <name operation="case insensitive equals">windir</name>
    </environmentvariable58_state>
    <environmentvariable58_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:3" version="1" comment="name must not be PATH" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <name operation="case insensitive not equal">windir</name>
    </environmentvariable58_state>
    <environmentvariable58_state id="oval:navy.navwar.niwcatlantic.scc.test:ste:5" version="1" comment="name must start with S" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <name operation="pattern match">^S.*$</name>
    </environmentvariable58_state>
  </states>
  <variables>
    <local_variable id="oval:navy.navwar.niwcatlantic.scc.test:var:3" version="1"  datatype="int" comment="get a PID (current process)" >    
      <object_component object_ref="oval:navy.navwar.niwcatlantic.scc.test:obj:1" item_field="pid"/> 
    </local_variable>  
  </variables>
</oval_definitions>
