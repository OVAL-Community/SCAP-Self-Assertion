       <variables>
        <local_variable comment="Merged format of PreshutdownOrder - no sort" datatype="string" id="oval:navy.navwar.niwcatlantic.scc:var:1" version="1">
          <merge delimiter="," sort="document">
            <object_component object_ref="oval:navy.navwar.niwcatlantic.scc:obj:100" item_field="value" />
          </merge>
        </local_variable>
      <local_variable comment="Merged format of PreshutdownOrder - sort natural" datatype="string" id="oval:navy.navwar.niwcatlantic.scc:var:2" version="1">
