  <definitions>
    <definition id="oval:org.mitre.oval.test:def:354" version="1" class="miscellaneous">
      <metadata>
        <title>Evaluate to true if the ind-def:environmentvariable58_test is properly supported</title>
        <description>This definition is intended to evalutate to true if the interpreter properly supports the ind-def:environmentvariable58_test and all of its valid operations.</description>
      </metadata>
      <notes>
        <note>It is important to note that the values used in this test definition are specific to a particular machine, and may not necessarily apply to your system. As a result, in order to have the definition return a result of 'true', you must either change these values to the ones found on your particular system, or you must configure your system to use these values.</note>
      </notes>
      <criteria operator="AND">
        <criterion comment="Test that the current process can be queried using a nil pid" test_ref="oval:org.mitre.oval.test:tst:1514"/>
        <criterion comment="Test querying a specific process ID(1)." test_ref="oval:org.mitre.oval.test:tst:1618"/>
        <criterion comment="A slightly more complex query which scans all processes and uses a regex on the variable name" test_ref="oval:org.mitre.oval.test:tst:1344"/>
      </criteria>
    </definition>
  </definitions>
  <tests>
    <environmentvariable58_test id="oval:org.mitre.oval.test:tst:1514" version="1" comment="Test that the current process can be queried using a nil pid." check_existence="at_least_one_exists" check="at least one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <object object_ref="oval:org.mitre.oval.test:obj:1462"/>
      <state state_ref="oval:org.mitre.oval.test:ste:1074"/>
    </environmentvariable58_test>
    <environmentvariable58_test id="oval:org.mitre.oval.test:tst:1618" version="1" comment="Test querying a specific process ID(1)." check_existence="at_least_one_exists" check="at least one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <object object_ref="oval:org.mitre.oval.test:obj:1264"/>
      <state state_ref="oval:org.mitre.oval.test:ste:1173"/>
    </environmentvariable58_test>
    <environmentvariable58_test id="oval:org.mitre.oval.test:tst:1344" version="1" comment="Get env vars of all processes which start with S." check_existence="at_least_one_exists" check="at least one" xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <object object_ref="oval:org.mitre.oval.test:obj:1032"/>
      <state state_ref="oval:org.mitre.oval.test:ste:869"/>
    </environmentvariable58_test>
  </tests>
  <objects>
    <environmentvariable58_object id="oval:org.mitre.oval.test:obj:1462" version="1" comment="Get the home directory of the current process user." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <pid datatype="int" xsi:nil="true"/>
      <name>HOME</name>
    </environmentvariable58_object>
    <environmentvariable58_object id="oval:org.mitre.oval.test:obj:1264" version="1" comment="Get non-PATH env vars of a particular pid (1 - init)." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <pid datatype="int" var_ref="oval:navy.navwar.niwcatlantic.scc.test:var:1" />
      <name operation="not equal">PATH</name>
    </environmentvariable58_object>
    <environmentvariable58_object id="oval:org.mitre.oval.test:obj:1032" version="1" comment="Get env vars of all processes which start with S." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <pid datatype="int" operation="greater than">0</pid>
      <name operation="pattern match">^S</name>
    </environmentvariable58_object>
	<unix-def:process58_object id="oval:navy.navwar.niwcatlantic.scc.test:obj:1" version="1" comment="Retrieve a pid that should exist on all solaris systems.">
		<unix-def:command_line operation="pattern match">svc\.startd</unix-def:command_line>
		<unix-def:pid datatype="int" operation="greater than">1</unix-def:pid>
	</unix-def:process58_object>
  </objects>
  <states>
    <environmentvariable58_state id="oval:org.mitre.oval.test:ste:1074" version="1" comment="Name must be 'HOME'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <name>HOME</name>
    </environmentvariable58_state>
    <environmentvariable58_state id="oval:org.mitre.oval.test:ste:1173" version="1" comment="Name must not be 'PATH'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <name operation="case insensitive not equal">PATH</name>
    </environmentvariable58_state>
    <environmentvariable58_state id="oval:org.mitre.oval.test:ste:869" version="1" comment="Name must start with 'S'." xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5#independent">
      <name operation="pattern match">^S</name>
    </environmentvariable58_state>
  </states>
	<variables>
		<local_variable id="oval:navy.navwar.niwcatlantic.scc.test:var:1" version="0" datatype="int" comment="retrieve pid for svc.startd.">
			<object_component object_ref="oval:navy.navwar.niwcatlantic.scc.test:obj:1" item_field="pid" />
		</local_variable>
	</variables>
